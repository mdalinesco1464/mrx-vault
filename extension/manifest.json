{
  "manifest_version": 3,
  "name": "MRX-Vault Assistant",
  "version": "1.0",
  "description": "Auto-fill and auto-save passwords securely with local MRX-Vault",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}